     "approve": false, "query": "after hours crisis line wellness",
     "expect": {"citations_exclude_titles": ["After Hours Crisis Line"], "text_excludes": ["555-0100"]},
     "mitigations": ["pending content is never citable"]},
    {"id": "RP-03", "class": "retrieval_poisoning", "severity": "high", "kind": "ingest", "legacy": false,
     "title": "Page altered after approval",
